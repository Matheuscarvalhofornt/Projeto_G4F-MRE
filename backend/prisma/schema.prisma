generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Noticia {
  id        Int    @id @default(autoincrement())
  titulo    String @db.VarChar(160)
  descricao String @db.Text

  @@index([titulo])
  @@map("noticias")
}
